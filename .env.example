# Postgres (container superuser, only used for initialization)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=okore
POSTGRES_PORT=5432

# Agent connection: read-only role
AGENT_DB_URL=postgresql://agent_ro:agent_ro@localhost:5432/okore

# Simulated actions service connection: write role
BACKEND_DB_URL=postgresql://backend_rw:backend_rw@localhost:5432/okore

# Simulated APIs
MOCKS_URL=http://localhost:8001
# Fault injected into the workshops API: empty | 500 | timeout
FAULT_WORKSHOPS=

# LLM: mock (scripted, no network) | openai_compat (Ollama, vLLM, OpenAI...)
LLM_PROVIDER=mock
LLM_BASE_URL=http://localhost:11434/v1
# Same server as seen from the agent container
DOCKER_LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5:14b
LLM_API_KEY=not-needed-for-ollama
LLM_TIMEOUT_S=60

# Jev (TypeSafe) for intent routing and guardrails; empty = regex rules
TYPESAFE_API_KEY=

# Trace output (one JSON line per ask/confirm)
TRACE_PATH=logs/agent_runs.jsonl